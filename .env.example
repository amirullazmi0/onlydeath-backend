PORT=4000
FE_URL=http://localhost:3000
# Public URL of this backend (ngrok in dev), used for webhook URLs
BE_PUBLIC_URL=http://localhost:4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/onlydeath?schema=public

JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

ADMIN_EMAIL=admin@onlydeath.local
ADMIN_PASSWORD=admin12345

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=OnlyDeath
SMTP_FROM_EMAIL=noreply@onlydeath.local

# Payment gateway for new checkouts: mayar | midtrans
# Orders keep the gateway they were created with, so switching is safe at any time;
# keep both sets of keys while older orders on the previous gateway are still open.
PAYMENT_GATEWAY=mayar

# Mayar (sandbox keys from web.mayar.io, production from web.mayar.id; "Read & Write")
MAYAR_API_KEY=your_mayar_api_key
MAYAR_IS_PRODUCTION=false
MAYAR_DASHBOARD_URL=https://web.mayar.io
# Mayar does not sign webhooks; set the webhook URL in the Mayar dashboard to
# ${BE_PUBLIC_URL}/payments/mayar/webhook?token=<MAYAR_WEBHOOK_TOKEN>
MAYAR_WEBHOOK_TOKEN=change_me

# Midtrans; set "Payment Notification URL" to ${BE_PUBLIC_URL}/payments/midtrans/notification
MIDTRANS_SERVER_KEY=your_midtrans_server_key
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_DASHBOARD_URL=https://dashboard.sandbox.midtrans.com

# Biteship (Indonesia only; the sender address is set in Admin > Settings)
BITESHIP_API_KEY=your_biteship_api_key
BITESHIP_BASE_URL=https://api.biteship.com
BITESHIP_COURIERS=jne,jnt,sicepat,anteraja
# Biteship does not sign webhooks; set the same header/secret on the Biteship dashboard
BITESHIP_WEBHOOK_HEADER=x-biteship-token
BITESHIP_WEBHOOK_TOKEN=change_me

# ImageKit
IMAGEKIT_PRIVATE_KEY=your_private_key
IMAGEKIT_FOLDER=/onlydeath

# Currency: international buyers see USD, the payment gateway charges the IDR equivalent
FX_API_URL=https://open.er-api.com/v6/latest/USD
USD_IDR_FALLBACK_RATE=16000

# Store details printed on invoices
STORE_NAME=ONLYDEATH
STORE_TAGLINE=Streetwear
STORE_ADDRESS=Jl. Contoh No. 123, Bandung, Indonesia
STORE_PHONE=+62 812 3456 7890
STORE_EMAIL=hello@onlydeath.local
STORE_WEBSITE=onlydeath.local
